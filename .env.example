LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
OPENROUTER_MAX_TOKENS=4096

# Vertex AI ADC mode
# Set LLM_PROVIDER=vertexai_adc to use Google Application Default Credentials.
# For Vertex Model Garden MaaS OpenAPI models, use the shared "openapi"
# endpoint id unless your project uses a custom Vertex endpoint.
VERTEXAI_PROJECT=
# GOOGLE_CLOUD_PROJECT is also accepted as a project alias.
VERTEXAI_LOCATION=global
# GOOGLE_VERTEX_LOCATION is also accepted as a location alias.
# Short GLM aliases are accepted: glm-5 -> zai-org/glm-5-maas.
VERTEXAI_MODEL=glm-5
VERTEXAI_ENDPOINT_ID=openapi
VERTEXAI_MAX_TOKENS=4096
# Optional full override, for example:
# VERTEXAI_BASE_URL=https://us-central1-aiplatform.googleapis.com/v1/projects/PROJECT/locations/us-central1/endpoints/ENDPOINT_ID

# Runtime cleanup
# RUN_METRICS=1 writes reports/metrics_<timestamp>.json and appends token/timing
# metrics to the markdown report. Token counts are provider-reported, not guessed.
RUN_METRICS=1
# AUTO_CLEANUP=1 removes containers/images/volumes/networks created by the run.
# Build cache is kept by default; set CLEAN_DOCKER_CACHE=1 when disk gets large.
AUTO_CLEANUP=1
CLEAN_DOCKER_CACHE=0
# Heavy option: docker system prune -af --volumes after a run.
CLEAN_DOCKER_SYSTEM=0

# Executor reasoning budget (the only true ReAct agent). Default 4000.
# EXECUTOR_MAX_TOKENS=4000
# Hardcoded per-challenge CTF SQL fast-path (coupon/monitor). Default OFF for an
# objective baseline — it is a lookup table, not agent reasoning. Set =1 for demos only.
# CTF_DIRECT_SQL_FALLBACK=0


# For Tracing (Optional)

# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
